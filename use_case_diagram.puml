@startuml
title Diagramme de Cas d'Utilisation - Système d'Enrichissement de Documents Pharmaceutiques

!define BUSINESS_COLOR #E8F4FD
!define SYSTEM_COLOR #FFF2CC
!define EXPERT_COLOR #D5E8D4
!define AI_COLOR #FFE6CC

left to right direction

actor "👨‍💼 Expert\nPharmaceutique" as Expert EXPERT_COLOR
actor "👤 Métadonneur" as User
actor "🤖 Système IA" as AI AI_COLOR
actor "🔧 Administrateur" as Admin

package "📄 Gestion Documents" BUSINESS_COLOR {
  usecase "Télécharger PDF" as UC1
  usecase "Visualiser Document" as UC2
  usecase "Naviguer Pages" as UC3
  usecase "Sélectionner Texte" as UC4
  usecase "Gérer Métadonnées" as UC5
}

package "🔍 Extraction & Annotation" SYSTEM_COLOR {
  usecase "Extraire Annotations" as UC6
  usecase "Identifier Entités" as UC7
  usecase "Détecter Dosages" as UC8
  usecase "Reconnaître Indications" as UC9
  usecase "Générer JSON" as UC10
}

package "🧠 Enrichissement Intelligent" EXPERT_COLOR {
  usecase "Enrichir Automatiquement" as UC11
  usecase "Générer Relations" as UC12
  usecase "Créer Q&A" as UC13
  usecase "Produire Résumé" as UC14
  usecase "Comparer IA vs Expert" as UC15
  usecase "Régénérer avec Apprentissage" as UC16
}

package "🎨 Créateur Visuel Relations" EXPERT_COLOR {
  usecase "Ouvrir Interface Visuelle" as UC17
  usecase "Gérer Entités Canvas" as UC18
  usecase "Ajouter Entités" as UC19
  usecase "Créer Nouvelles Entités" as UC20
  usecase "Positionner Entités" as UC21
  usecase "Créer Relations" as UC22
  usecase "Choisir Type Relation" as UC23
  usecase "Décrire Relation" as UC24
  usecase "Auto-organiser Canvas" as UC25
  usecase "Sauvegarder Relations" as UC26
}

package "❓ Système Q&A" EXPERT_COLOR {
  usecase "Tester Système Q&A" as UC27
  usecase "Poser Question" as UC28
  usecase "Évaluer Réponse" as UC29
  usecase "Corriger Réponses" as UC30
  usecase "Ajouter Q&A Manuelles" as UC31
  usecase "Analyser Paragraphes" as UC32
  usecase "Extraire Relations Texte" as UC33
}

package "📊 Apprentissage" EXPERT_COLOR {
  usecase "Consulter Historique" as UC34
  usecase "Analyser Améliorations" as UC35
  usecase "Visualiser Statistiques" as UC36
  usecase "Enregistrer Patterns" as UC37
}

package "💾 Gestion Données" EXPERT_COLOR {
  usecase "Éditer JSON Enrichi" as UC38
  usecase "Sauvegarder Modifications" as UC39
  usecase "Exporter Données" as UC40
  usecase "Gérer Annotations" as UC41
}

package "🔧 Administration" {
  usecase "Gérer Utilisateurs" as UC42
  usecase "Configurer IA" as UC43
  usecase "Monitorer Performances" as UC44
}

